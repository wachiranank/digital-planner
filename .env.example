# Same Supabase project as the store
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# The store (license API) — server-side and the public "buy" link
STORE_URL=https://digital-product-store-flax.vercel.app
NEXT_PUBLIC_STORE_URL=https://digital-product-store-flax.vercel.app

# Google OAuth client (same one configured in Supabase) — used server-side to refresh Calendar tokens
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 5 — push reminders (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for /api/cron/reminders (Supabase pg_cron calls it every 5 min)
CRON_SECRET=
